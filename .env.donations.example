# Donations are OFF by default. Never enable live payments as part of a preview.
# Merge these settings into your server's private environment; do not commit values.
DONATIONS_ENABLED=false
DONATIONS_ALLOW_LIVE=false
DONATIONS_ORIGIN=http://127.0.0.1:3000

# Dedicated PostgreSQL database/user. Do not point tests at a production database.
DATABASE_URL=
# Stable independent encryption key, >=32 random characters. Back up securely.
# Capability replay and private management links depend on it; do not casually rotate.
DONATIONS_TOKEN_SECRET=
# Enable ONLY behind a trusted proxy that REPLACES X-Real-IP and blocks direct access.
DONATIONS_TRUST_PROXY=false
DONATIONS_PROXY_IP_HEADER=x-real-ip

# Amounts below are integer minor units (cents), not dollars/reais.
DONATIONS_USD_MIN=500
DONATIONS_USD_MAX=10000000
DONATIONS_USD_ONCE_SUGGESTED=2500,5000,10000,25000
DONATIONS_USD_MONTHLY_SUGGESTED=1000,2500,5000,10000
DONATIONS_BRL_MIN=500
DONATIONS_BRL_MAX=10000000
DONATIONS_BRL_ONCE_SUGGESTED=10000,25000,50000,100000
DONATIONS_BRL_MONTHLY_SUGGESTED=5000,10000,25000,50000

# Stripe: use TEST account keys and a test webhook endpoint first.
# The backend refuses sk_live_ keys unless the separate live gate is enabled.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Explicit operator-verified presentment allowlist, intersected with account checks.
# Empty means unavailable until account/payment QA is complete.
STRIPE_DONATION_CURRENCIES=

# BTCPay: provision a separate test network instance/store before integration QA.
# A mainnet installation is NOT a test server, even if no funds are deposited.
BTCPAY_ENABLED=false
BTCPAY_URL=
BTCPAY_API_KEY=
BTCPAY_STORE_ID=
BTCPAY_WEBHOOK_SECRET=
BTCPAY_TEST_NETWORK=false
# Private deployment/RPC evidence bound to origin/store/version, valid for 24h.
BTCPAY_NETWORK_ATTESTATION_FILE=
BTCPAY_MANUAL_PLEDGES=false
# Preconfigured native offering; custom validated amounts create/reuse safe plans.
BTCPAY_MONTHLY_OFFERING_ID=
BTCPAY_MONTHLY_PLANS={}

# Transactional delivery uses the existing Resend service.
RESEND_API_KEY=
# Sender for the site's own mail (contact form). Leave as is.
RESEND_FROM_EMAIL=
# Sender for donation mail only. Falls back to RESEND_FROM_EMAIL when empty.
DONATIONS_FROM_EMAIL=
RESEND_TO_EMAIL=
# Existing Ghost membership database; newsletter is opt-in only.
GHOST_URL=
GHOST_ADMIN_API_KEY=
DONATIONS_GHOST_NEWSLETTER_ID=

# Schedule the authenticated jobs endpoint only after migrations and delivery QA.
DONATIONS_CRON_SECRET=

# Minimal named administrator accounts. Use the documented hash-generation tool.
# Store salts/hashes here, NEVER administrator plaintext passwords.
DONATIONS_ADMIN_ORIGIN=
DONATIONS_ADMIN_USERS=[]
DONATIONS_ADMIN_SESSION_SECRET=
